# 复制为 .env 并填入真实值（.env 勿提交）
DEEPSEEK_API_KEY=sk-你的密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# 固定知识库：个人文档库可用 lark-cli wiki +node-list --as user --space-id my_library 查看
# PARENT 为归档目录父节点（其下每个视频创建一篇 docx）
FEISHU_WIKI_SPACE_ID=
FEISHU_WIKI_PARENT_NODE_TOKEN=

# Telegram Bot 触发入口（配置 Token 后默认启用；不需要时设 TELEGRAM_ENABLED=0）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# TELEGRAM_ENABLED=0

# yt-dlp Cookie（可选；需登录/反爬的站点才需要）
#
# 方式 A：从已登录的浏览器读取（YouTube 推荐；读取时请先关闭该浏览器）
# 填浏览器名，可选 :配置文件，如 edge / chrome / chrome:Default
# YTDLP_COOKIES_FROM_BROWSER_YOUTUBE=chrome
# YTDLP_COOKIES_FROM_BROWSER_DOUYIN=chrome
# YTDLP_COOKIES_FROM_BROWSER=
#
# 方式 B：Netscape 格式 cookie 文件（浏览器插件导出）
# 默认放在项目 cookies/ 目录：
#   cookies/www.bilibili.com_cookies.txt
#   cookies/www.youtube.com_cookies.txt
#   cookies/www.douyin.com_cookies.txt
# YTDLP_COOKIE_FILE_BILIBILI=cookies/www.bilibili.com_cookies.txt
# YTDLP_COOKIE_FILE_YOUTUBE=cookies/www.youtube.com_cookies.txt
# YTDLP_COOKIE_FILE_DOUYIN=cookies/www.douyin.com_cookies.txt
# YTDLP_COOKIE_FILE=
